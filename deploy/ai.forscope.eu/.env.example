# Copy to .env (mode 600). Secrets are generated once and never committed.

# --- secrets ---------------------------------------------------------------
CREDS_KEY=            # 32 bytes hex: openssl rand -hex 32
CREDS_IV=             # 16 bytes hex: openssl rand -hex 16
JWT_SECRET=           # openssl rand -hex 32
JWT_REFRESH_SECRET=   # openssl rand -hex 32
MEILI_MASTER_KEY=     # openssl rand -hex 32
TANDEVIA_GATEWAY_KEY= # API key of the application "LibreChat (ai.forscope.eu)" on gateway.forscope.eu
GOOGLE_CLIENT_ID=     # Google Cloud Console, OAuth client "Tandevia Workspace"
GOOGLE_CLIENT_SECRET=

# --- identity --------------------------------------------------------------
APP_TITLE=Tandevia Workspace
HELP_AND_FAQ_URL=https://tandevia.com
DOMAIN_CLIENT=https://ai.forscope.eu
DOMAIN_SERVER=https://ai.forscope.eu
TRUST_PROXY=1
NO_INDEX=true

# --- sign-in: Google Workspace only ----------------------------------------
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
GOOGLE_CALLBACK_URL=/oauth/google/callback

# --- schedules (one replica, in-memory job store) ---------------------------
SCHEDULES_SINGLE_PROCESS=true

# --- search ----------------------------------------------------------------
SEARCH=true
MEILI_NO_ANALYTICS=true

# --- image -----------------------------------------------------------------
WORKSPACE_IMAGE_TAG=tandevia
